{
	"name": "@bhemu/chat",
	"version": "0.1.0",
	"private": true,
	"description": "Chat API client and hooks for bCampus — shared between web and mobile",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsc --emitDeclarationOnly",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bhemu/shared": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	}
}
