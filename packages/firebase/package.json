{
	"name": "@bhemu/firebase",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Firebase services for Bhemu Calculator (GPA, Attendance, Leaderboard)",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bhemu/shared": "workspace:*",
		"firebase": "^12.13.0"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.7.0"
	}
}
