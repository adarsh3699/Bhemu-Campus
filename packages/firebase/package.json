{
	"name": "@bhemu/firebase",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Firebase services for bCampus (GPA, Attendance, Leaderboard)",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsc --emitDeclarationOnly",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bhemu/shared": "workspace:*",
		"firebase": "^12.17.1"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	}
}
