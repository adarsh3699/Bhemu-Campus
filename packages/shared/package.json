{
	"name": "@bhemu/shared",
	"version": "0.1.0",
	"private": true,
	"description": "Shared types, constants, utilities, and parsers for bCampus",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsc --emitDeclarationOnly",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
