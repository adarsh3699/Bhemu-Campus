{
  "name": "ums-extension",
  "displayName": "UMS Data Sync",
  "version": "1.0.0",
  "description": "Automatically sync your LPU UMS academic data — grades, attendance, timetable",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.12.0",
    "firebase": "^10.12.0",
    "linkedom": "^0.18.12",
    "plasmo": "^0.90.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.34.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "tabs",
      "webNavigation"
    ],
    "host_permissions": [
      "https://ums.lpu.in/*",
      "https://firestore.googleapis.com/*",
      "https://identitytoolkit.googleapis.com/*",
      "https://securetoken.googleapis.com/*"
    ]
  }
}
