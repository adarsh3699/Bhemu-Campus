+    private void syncCookies(String url, java.net.HttpURLConnection conn) {
+        java.util.List<String> cookieHeaders = conn.getHeaderFields().get("Set-Cookie");
+        if (cookieHeaders == null) cookieHeaders = conn.getHeaderFields().get("set-cookie");
+        if (cookieHeaders != null) {
+            CookieManager cm = CookieManager.getInstance();
+            for (String cookie : cookieHeaders) {
+                cm.setCookie(url, cookie);
+            }
+            cm.flush();
+        }
+    }
+
+    @Override
+    @androidx.annotation.RequiresApi(21)
+    public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+        String host = request.getUrl().getHost();
+        if (host == null || !(host.equalsIgnoreCase("ums.lpu.in") || host.endsWith(".ums.lpu.in"))) {
+            return super.shouldInterceptRequest(view, request);
+        }
+        String requestUrl = request.getUrl().toString();
+        String path = request.getUrl().getPath();
+        if (path != null && path.startsWith("/cdn-cgi/")) {
+            return super.shouldInterceptRequest(view, request);
+        }
+        String method = request.getMethod().toUpperCase();
+        String postBody = null;
+        if ("POST".equals(method) && request.isForMainFrame()) {
+            for (int i = 0; i < 25; i++) {
+                postBody = RNCWebView.pendingUmsPostBody.getAndSet(null);
+                if (postBody != null) break;
+                try { Thread.sleep(10); } catch (InterruptedException ignored) {}
+            }
+            if (postBody == null) return super.shouldInterceptRequest(view, request);
+        } else if ("POST".equals(method)) {
+            return super.shouldInterceptRequest(view, request);
+        }
+        try {
+            java.net.URL url = new java.net.URL(requestUrl);
+            java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
+            conn.setRequestMethod(method);
+            conn.setInstanceFollowRedirects(false);
+            conn.setConnectTimeout(10000);
+            conn.setReadTimeout(15000);
+            for (java.util.Map.Entry<String, String> entry : request.getRequestHeaders().entrySet()) {
+                if (!entry.getKey().equalsIgnoreCase("X-Requested-With")
+                    && !entry.getKey().equalsIgnoreCase("Accept-Encoding")) {
+                    conn.setRequestProperty(entry.getKey(), entry.getValue());
+                }
+            }
+            conn.setRequestProperty("Accept-Encoding", "identity");
+            String cookies = CookieManager.getInstance().getCookie(requestUrl);
+            if (cookies != null) conn.setRequestProperty("Cookie", cookies);
+            if ("POST".equals(method) && postBody != null) {
+                byte[] bodyBytes = postBody.getBytes("UTF-8");
+                conn.setDoOutput(true);
+                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+                conn.setRequestProperty("Content-Length", String.valueOf(bodyBytes.length));
+                conn.getOutputStream().write(bodyBytes);
+            }
+            conn.connect();
+            syncCookies(requestUrl, conn);
+            int code = conn.getResponseCode();
+            if (code == 301 || code == 302 || code == 303 || code == 307) {
+                String loc = conn.getHeaderField("Location");
+                if (loc != null) {
+                    if (!loc.startsWith("http")) {
+                        loc = new java.net.URL(url, loc).toString();
+                    }
+                    String redir = "<html><head>" +
+                        "<script>window.location.replace('" + loc.replace("'", "\\'") + "');</script>" +
+                        "</head><body></body></html>";
+                    byte[] bytes = redir.getBytes("UTF-8");
+                    java.util.Map<String, String> h = new java.util.HashMap<>();
+                    h.put("Content-Type", "text/html; charset=UTF-8");
+                    return new WebResourceResponse("text/html", "UTF-8", 200, "OK", h,
+                        new java.io.ByteArrayInputStream(bytes));
+                }
+            }
+            String contentType = conn.getContentType();
+            java.io.InputStream is = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            if (is == null) is = new java.io.ByteArrayInputStream(new byte[0]);
+            String mime = contentType != null ? contentType.split(";", 2)[0].trim() : "application/octet-stream";
+            String encoding = "UTF-8";
+            java.util.Map<String, String> headers = new java.util.HashMap<>();
+            for (java.util.Map.Entry<String, java.util.List<String>> e : conn.getHeaderFields().entrySet()) {
+                if (e.getKey() != null && !e.getValue().isEmpty()
+                    && !e.getKey().equalsIgnoreCase("Set-Cookie")) {
+                    headers.put(e.getKey(), e.getValue().get(0));
+                }
+            }
+            String reason = conn.getResponseMessage();
+            return new WebResourceResponse(mime, encoding, code, reason != null ? reason : "OK", headers, is);
+        } catch (Exception e) {
+            // Fall through on any error so the page still loads
+        }
+        return super.shouldInterceptRequest(view, request);
+    }
