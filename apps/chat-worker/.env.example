# Random secret used to sign and verify chat session tokens.
# Generate one with: openssl rand -base64 32
CHAT_SESSION_SECRET=

# PostgreSQL connection string used by Drizzle.
DATABASE_URL=

# Firebase project ID used for Firestore and Firebase Cloud Messaging.
FIREBASE_PROJECT_ID="bhemu-calc"

# Full Firebase service-account JSON, stored as one quoted/escaped value.
# Keep this private and never commit it. Generate it in Firebase Console:
# Project settings > Service accounts > Generate new private key.
# Example:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"bhemu-calc","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@bhemu-calc.iam.gserviceaccount.com"}'
FIREBASE_SERVICE_ACCOUNT_KEY=