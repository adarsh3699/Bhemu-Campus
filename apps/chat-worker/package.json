    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.119.0"
