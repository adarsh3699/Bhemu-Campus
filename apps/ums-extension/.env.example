PLASMO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
PLASMO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
PLASMO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
PLASMO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
PLASMO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
PLASMO_PUBLIC_FIREBASE_APP_ID="your-app-id"

# bCampus web app URL — used for the "Use bCampus session" login flow
# Set to localhost during development, production URL in prod
PLASMO_PUBLIC_CALC_URL="http://localhost:3000"

# Show "View Last Sync Data" button — developer-only debug tool
# Set to "true" in development, "false" (or omit) in production
PLASMO_PUBLIC_DEV_MODE="false"
