{
	"name": "bcampus-ums-sync",
	"displayName": "bCampus - UMS Sync",
	"version": "1.2.6",
	"description": "Sync your LPU UMS grades, marks, and attendance to bCampus with one click.",
	"private": true,
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix"
	},
	"dependencies": {
		"@bhemu/firebase": "workspace:*",
		"@bhemu/shared": "workspace:*",
		"@plasmohq/storage": "^1.15.0",
		"firebase": "^12.17.1",
		"linkedom": "^0.18.13",
		"plasmo": "^0.90.5",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/chrome": "^0.2.5",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^9.39.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.9.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"manifest": {
		"permissions": [
			"storage",
			"tabs",
			"webNavigation"
		],
		"host_permissions": [
			"https://ums.lpu.in/*",
			"https://firestore.googleapis.com/*",
			"https://identitytoolkit.googleapis.com/*",
			"https://securetoken.googleapis.com/*"
		]
	}
}
