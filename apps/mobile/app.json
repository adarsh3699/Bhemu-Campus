{
	"expo": {
		"name": "bCampus",
		"slug": "bhemu-campus",
		"owner": "adarsh3699",
		"version": "1.2.0",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/9437afb0-7d61-43d4-bb58-c4c2dc4e124f",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0
		},
		"scheme": "bhemu",
		"orientation": "portrait",
		"icon": "./assets/app_icon.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "in.bhemu.campus"
		},
		"android": {
			"versionCode": 1,
			"softwareKeyboardLayoutMode": "resize",
			"adaptiveIcon": {
				"foregroundImage": "./assets/app_icon.png",
				"backgroundColor": "#0E0E0E"
			},
			"permissions": ["SCHEDULE_EXACT_ALARM", "REQUEST_INSTALL_PACKAGES"],
			"package": "in.bhemu.campus",
			"googleServicesFile": "./google-services.json"
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/logo_with_text.png"
		},
		"plugins": [
			"expo-router",
			"expo-font",
			"expo-notifications",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-screen.png",
					"resizeMode": "contain",
					"backgroundColor": "#0E0E0E"
				}
			],
			"@react-native-google-signin/google-signin"
		],
		"experiments": {
			"typedRoutes": false
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9437afb0-7d61-43d4-bb58-c4c2dc4e124f"
			}
		}
	}
}
