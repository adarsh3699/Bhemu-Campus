# Firebase config — same project as apps/frontend
# Copy values from apps/frontend/.env.local (rename NEXT_PUBLIC_ → EXPO_PUBLIC_)
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""

# Google Sign-In — Web Client ID from Firebase Console → Authentication → Google provider
# (same client ID used by @react-native-google-signin; SHA-1 must be registered in Firebase)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=""